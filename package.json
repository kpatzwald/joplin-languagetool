{
	"name": "joplin-plugin-languagetool",
	"version": "1.4.0",
	"author": "Kay Patzwald",
	"homepage": "https://github.com/kpatzwald/joplin-languagetool",
	"repository": {
		"type": "git",
		"url": "https://github.com/kpatzwald/joplin-languagetool.git"
	},
	"scripts": {
		"test": "node test/contentScript.test.js && node test/resultsDialog.test.js && node test/url.test.js && node test/english.test.js && node test/i18n.test.js",
		"dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
		"prepare": "npm run dist",
		"updateVersion": "webpack --env joplin-plugin-config=updateVersion"
	},
	"license": "MIT",
	"keywords": [
		"joplin-plugin",
		"languagetool",
		"spellcheck",
		"grammar"
	],
	"files": [
		"publish"
	],
	"devDependencies": {
		"@codemirror/state": "^6.4.0",
		"@codemirror/view": "^6.28.0",
		"@types/node": "^18.7.13",
		"chalk": "^4.1.0",
		"copy-webpack-plugin": "^11.0.0",
		"fs-extra": "^10.1.0",
		"glob": "^8.0.3",
		"jsdom": "^26.1.0",
		"tar": "^6.1.11",
		"ts-loader": "^9.3.1",
		"typescript": "^4.8.2",
		"webpack": "^5.74.0",
		"webpack-cli": "^4.10.0"
	}
}
